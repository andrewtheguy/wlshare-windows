<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    Per-machine MSI for the wlshare Windows client: the self-contained WinUI 3
    app published into $(var.PublishDir), with the Rust core's DLL beside it.
    No wizard: there is nothing to choose, so it installs to Program Files and
    puts a Start-menu entry up. Unsigned, as the macOS app is.
  -->
  <Package
      Name="wlshare"
      Manufacturer="andrewtheguy"
      Version="$(var.ProductVersion)"
      UpgradeCode="4c634771-55ef-4615-813d-e4afb545d175"
      Scope="perMachine"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of wlshare is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="wlshare.ico" SourceFile="$(var.PublishDir)\wlshare.ico" />
    <Property Id="ARPPRODUCTICON" Value="wlshare.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="wlshare" />
    </StandardDirectory>

    <Feature Id="Main" Title="wlshare" Level="1">
      <Files Directory="INSTALLFOLDER" Include="$(var.PublishDir)\**" />
      <ComponentGroupRef Id="Shortcut" />
    </Feature>

    <ComponentGroup Id="Shortcut">
      <Component Directory="ProgramMenuFolder" Id="StartMenuShortcut" Guid="430458b2-4476-4286-b992-97ed6d4d5269">
        <Shortcut Id="WlshareShortcut"
                  Name="wlshare"
                  Description="A window onto a wlshare desktop"
                  Target="[INSTALLFOLDER]WlshareViewer.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <!-- A non-advertised shortcut's component needs an HKCU registry value
             as its KeyPath (ICE38/ICE43/ICE57), even in a per-machine package. -->
        <RegistryValue Root="HKCU" Key="Software\wlshare" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

  </Package>
</Wix>
